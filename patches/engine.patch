diff --git a/src/system_sdl.go b/src/system_sdl.go
index 8eea3d3..59c46cb 100644
--- a/src/system_sdl.go
+++ b/src/system_sdl.go
@@ -6,6 +6,8 @@ import (
 	"image/draw"
 	"math"
 	"runtime"
+	"strconv"
+	"strings"
 
 	"github.com/veandco/go-sdl2/sdl"
 )
@@ -247,6 +249,19 @@ func (w *Window) GetScaledViewportSize() (int32, int32, int32, int32) {
 		resizedHeight = int32(float32(resizedWidth) / aspectGame)
 		x = 0
 		y = (int32(winHeight) - resizedHeight) / 2
+		// Fist of Retribution phone layout: the app shell sets the SDL hint FOR_VIEW_TOP to the number of
+		// pixels to leave above the picture (status bar / camera cut-out). The picture then sits at the top
+		// of the tall window and the shell draws its arcade stick and buttons in the space underneath.
+		if top, ok := forViewTop(); ok {
+			if top > int32(winHeight)-resizedHeight {
+				top = int32(winHeight) - resizedHeight
+			}
+			if strings.HasPrefix(sys.cfg.Video.RenderMode, "Vulkan") {
+				y = top // Vulkan viewports count from the top edge
+			} else {
+				y = int32(winHeight) - resizedHeight - top // OpenGL viewports count from the bottom edge
+			}
+		}
 	}
 
 	return x, y, resizedWidth, resizedHeight
@@ -484,3 +499,17 @@ func (w *Window) Close() {
 	}
 	sdl.Quit()
 }
+
+// forViewTop reads the FOR_VIEW_TOP hint (pixels to leave above the picture in a tall window).
+// It is re-read every frame so the shell can change it when the device is rotated, folded or unfolded.
+func forViewTop() (int32, bool) {
+	h := sdl.GetHint("FOR_VIEW_TOP")
+	if h == "" {
+		return 0, false
+	}
+	v, err := strconv.Atoi(strings.TrimSpace(h))
+	if err != nil || v < 0 {
+		return 0, false
+	}
+	return int32(v), true
+}
