+
+// forViewTop reads the FOR_VIEW_TOP hint (pixels to leave above the picture in a tall window).
+// It is re-read every frame so the shell can change it when the device is rotated, folded or unfolded.
+func forViewTop() (int32, bool) {
+	h := sdl.GetHint("FOR_VIEW_TOP")
+	if h == "" {
+		return 0, false
+	}
+	v, err := strconv.Atoi(strings.TrimSpace(h))
+	if err != nil || v < 0 {
+		return 0, false
+	}
+	return int32(v), true
+}
+
+// forViewRect reads the FOR_VIEW_RECT hint ("x,y,w,h" in drawable pixels from the top-left corner),
+// clamped to the window. It is re-read every frame so the shell can change it on rotation or a layout switch.
+func forViewRect(winW, winH int32) (int32, int32, int32, int32, bool) {
+	h := strings.TrimSpace(sdl.GetHint("FOR_VIEW_RECT"))
+	if h == "" {
+		return 0, 0, 0, 0, false
+	}
+	f := strings.FieldsFunc(h, func(r rune) bool { return r == ',' || r == ' ' })
+	if len(f) != 4 {
+		return 0, 0, 0, 0, false
+	}
+	var v [4]int32
+	for i, s := range f {
+		n, err := strconv.Atoi(s)
+		if err != nil {
+			return 0, 0, 0, 0, false
+		}
+		v[i] = int32(n)
+	}
+	x, y, w, hh := v[0], v[1], v[2], v[3]
+	if x < 0 {
+		x = 0
+	}
+	if y < 0 {
+		y = 0
+	}
+	if x+w > winW {
+		w = winW - x
+	}
+	if y+hh > winH {
+		hh = winH - y
+	}
+	if w < 16 || hh < 16 {
+		return 0, 0, 0, 0, false
+	}
+	return x, y, w, hh, true
+}
