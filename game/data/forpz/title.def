; Title / attract screen: the menu background and logo, a blinking PRESS START, and its own music
; ("Quarter in the Slot"). Any button skips to the main menu, which has its own music.
[Info]
localcoord = 1280,720

[SceneDef]
spr = system.sff
snd = system.snd
startscene = 0

[Scene 0]
clearcolor = 0,0,0
fadein.time = 30
fadein.col = 0,0,0
fadeout.time = 20
fadeout.col = 0,0,0
end.time = 10200
bg.name = TitleSB
bgm = sound/Title.mp3
bgm.loop = 1
layerall.pos = 0,0
layer0.anim = 10
layer0.offset = 640,600
layer0.starttime = 40
; the announcer's title call (Scott's voice)
sound0.value = 200,2
sound0.starttime = 35

[TitleSBDef]
bgclearcolor = 0,0,0

[TitleSB Sky]
type = normal
spriteno = 100,0
layerno = 0
start = -640,0

[TitleSB Clouds Top]
type = normal
spriteno = 100,2
layerno = 0
start = -640,-50
tile = 1,0
velocity = -0.1, 0
mask = 1

[TitleSB Clouds Bottom]
type = normal
spriteno = 100,3
layerno = 0
start = -640,0
tile = 1,0
velocity = -0.7, 0
mask = 1

[TitleSB Black Bars]
type = normal
spriteno = 100,1
layerno = 0
start = -640,0
trans = add1
mask = 1

[TitleSB Logo]
type = normal
spriteno = 0,0
layerno = 0
start = 0,250
scalestart = 1.3,1.3
mask = 1
sin.y = 6, 264, 2

; PRESS START blinking: 40 ticks on, 20 off
[Begin Action 10]
210,0, 0,0, 40
-1,-1, 0,0, 20
