[State -2, Gain start class 12]
type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = Time = 1 && (stateno = 1200 || stateno = 1201 || stateno = 1202 || stateno = 1252 || stateno = 1300 || stateno = 1301 || stateno = 1302 || stateno = 1400 || stateno = 1401 || stateno = 1402)
value = floor((3) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)

[State -2, Gain hit class 12]
type = PowerAdd
