type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = MoveGuarded && var(37) = 0 && (stateno = 1000 || stateno = 1001 || stateno = 1002)
value = floor((2) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
ignorehitpause = 1

[State -2, Gain start class 11]
type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = Time = 1 && (stateno = 1100 || stateno = 1101 || stateno = 1102 || stateno = 1510)
value = floor((3) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)

[State -2, Gain hit class 11]
type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = HitCount > var(36) && (stateno = 1100 || stateno = 1101 || stateno = 1102 || stateno = 1510)
value = floor((ifelse(HitCount = 1, 15, 2) * ifelse(ComboCount <= 1, 32, ifelse(ComboCount >= 16, 1, 32 - (ComboCount - 1) * 2)) / 32.0) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
