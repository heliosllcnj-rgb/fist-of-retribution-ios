;---------------------------------------------------------------------------
; Fist of Retribution: the opponent held on the lightning (custom state). Each hit puts them back here; the final
; blast (or a KO, or the drill ending early) sends them into a normal knockdown.
[Statedef 3390]
type = S
movetype = H
physics = N
ctrl = 0
velset = 0, 0

[State 3390, Anim]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(Random < 500 && SelfAnimExist(5010), 5010, 5000)

[State 3390, Ground]
type = PosSet
trigger1 = 1
y = 0

[State 3390, Push]
type = VelSet
trigger1 = Time < 3
x = -1.2

[State 3390, Hold]
type = VelSet
trigger1 = Time >= 3
x = 0

[State 3390, Out]
type = HitFallSet
trigger1 = Time >= 30 || !Alive
value = 1
xvel = -3
yvel = -5

[State 3390, Fall]
type = SelfState
trigger1 = Time >= 30 || !Alive
value = 5050

