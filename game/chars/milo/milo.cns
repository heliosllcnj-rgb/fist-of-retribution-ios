; Thrown forward. Ken's forward throw (ken_attr row 47, blow-away 4) sends the opponent forward at 1632/256 =
; 6.375 px/f and drops them almost at once, about one body length away - not a long, high toss. Milo shoves from
; a standing clinch, so the opponent takes a short low hop at that speed: 16 frames in the air.
[Statedef 821]
type = A
movetype = H
physics = N
velset = -5.67,-3.56
poweradd = 40

[State 821, Gravity]
type = VelAdd
trigger1 = 1
y = 0.445

[State 821, Recover near ground]
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = command = "recovery"
value = 5200

[State 821, Recover in air]
type = SelfState
triggerall = Vel Y > 0
triggerall = alive
triggerall = CanRecover
trigger1 = command = "recovery"
value = 5210

[State 821, Hit ground]
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100

; Thrown backward. Ken's back throw (ken_attr row 49, blow-away 5): 1904/256 = 7.44 px/f across, 2074/256 = 8.1 px/f
; up, gravity 160/256 = 0.625 (all x0.89 for our size). Ken throws from a roll on the ground; Milo lets go from
; shoulder height, so the upward speed is trimmed to keep the same low arc: the opponent stays on screen and
; lands a little over half a screen away.
[Statedef 822]
type = A
movetype = H
physics = N
velset = -7.0,-6.0
poweradd = 40

[State 822, Gravity]
type = VelAdd
trigger1 = 1
y = 0.556

[State 822, Recover near ground]
