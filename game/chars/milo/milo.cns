; Michael "Milo" Foster - constants and states
; Fist of Retribution: Project Zero - IKEMEN GO playable prototype (placeholder art)
; Generated by Claude from the ChatGPT Moveset Proposal v1.0. Frame data are first-pass values.

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 0.33333      ;sprites are stored at 3x for crisp HD rendering
yscale = 0.33333
ground.back = 15
ground.front = 16
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -90
mid.pos = -5, -60
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.06
walk.back = -2.34
run.fwd  = 5.2, 0
run.back = -4.5,-3.6
jump.neu = 0,-7.51
jump.back = -4.0
jump.fwd = 3.78
runjump.back = -4.0,-7.51
runjump.fwd = 4.35,-7.51
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5
air.gethit.groundrecover = -.15,-3.5
air.gethit.airrecover.mul = .5,.2
air.gethit.airrecover.add = 0,-4.5
air.gethit.airrecover.back = -1
air.gethit.airrecover.fwd = 0
air.gethit.airrecover.up = -2
air.gethit.airrecover.down = 1.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = 0.473
stand.friction = .85
crouch.friction = .82
stand.friction.threshold = 2
crouch.friction.threshold = .05
air.gethit.groundlevel = 25
air.gethit.groundrecover.ground.threshold = -20
air.gethit.groundrecover.groundlevel = 10
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = .35
air.gethit.trip.groundlevel = 15
down.bounce.offset = 0, 20
down.bounce.yaccel = .4
down.bounce.groundlevel = 12
down.friction.threshold = .05

[Quotes]
victory1 = "Bill taught me better than that."
victory2 = "That one was for the Training Station."
victory3 = "I'm still learning. So are you."

;---------------------------------------------------------------------------
; Variable usage
; var(5)  - Absolute Flow install timer (Andre only, ticks remaining)
; var(20) - Parry lockout timer (no new parry input while > 0)
; var(21) - Parry window timer (parry is armed while > 0)
; var(22) - Parry type: 1 = high (tap forward), 2 = low (tap down), 3 = air (tap forward in air)
; var(23) - Frames since the parry tap (the window shortens to 6 if the lever is held)
; var(24) - Lever was neutral last frame (a parry tap must start from neutral, as in 3rd Strike)
; var(25) - Lever has been released since the parry tap (a new press then closes the window)
; var(50) - Super Art picked on the select screen (1-3; the select screen's palette menu)
;---------------------------------------------------------------------------

;===========================================================================
; Every-frame system logic: parry windows (3rd Strike-style)
[Statedef -2]

[State -2, Super Art from select screen]
type = VarSet
trigger1 = RoundState <= 1 || var(50) = 0
var(50) = ifelse(PalNo >= 1 && PalNo <= 6, (PalNo - 1) % 3 + 1, 1)
ignorehitpause = 1

[State -2, Jump arc N]
type = VelAdd
trigger1 = statetype = A && movetype != H && var(26) = 1
x = 0.0
y = -0.0002

[State -2, Jump arc F]
type = VelAdd
trigger1 = statetype = A && movetype != H && var(26) = 2
x = -0.0278
y = -0.0002

[State -2, Jump arc B]
type = VelAdd
trigger1 = statetype = A && movetype != H && var(26) = 3
x = 0.0278
y = -0.028

[State -2, Jump arc SN]
type = VelAdd
trigger1 = statetype = A && movetype != H && var(26) = 4
x = 0.0
y = -0.0141

[State -2, Jump arc SF]
type = VelAdd
trigger1 = statetype = A && movetype != H && var(26) = 5
x = 0.0
y = 0.0276

[State -2, Jump arc SB]
type = VelAdd
trigger1 = statetype = A && movetype != H && var(26) = 6
x = 0.0
y = -0.028

[State -2, Jump landing stops]
type = VelSet
trigger1 = stateno = 52 || (stateno = 50 && pos y >= 0 && vel y > 0)
x = 0

[State -2, Jump arc over]
type = VarSet
trigger1 = var(26) != 0 && stateno != 40
trigger1 = statetype != A || movetype = H
var(26) = 0

[State -2, Push-back row 1]
type = PosAdd
trigger1 = stateno = 5001 || stateno = 5011 || stateno = 151 || stateno = 153
trigger1 = gethitvar(fall.envshake.time) = 1 && Time >= 1 && Time <= 7
x = -0.89 * (ifelse(Time = 1, 3, ifelse(Time = 2, 5, ifelse(Time = 3, 6, ifelse(Time = 4, 7, ifelse(Time = 5, 6, ifelse(Time = 6, 4, ifelse(Time = 7, 1, 0))))))))

[State -2, Push-back row 3]
type = PosAdd
trigger1 = stateno = 5001 || stateno = 5011 || stateno = 151 || stateno = 153
trigger1 = gethitvar(fall.envshake.time) = 3 && Time >= 1 && Time <= 9
x = -0.89 * (ifelse(Time = 1, 4, ifelse(Time = 2, 7, ifelse(Time = 3, 9, ifelse(Time = 4, 10, ifelse(Time = 5, 11, ifelse(Time = 6, 8, ifelse(Time = 7, 6, ifelse(Time = 8, 4, ifelse(Time = 9, 1, 0))))))))))

[State -2, Push-back row 4]
type = PosAdd
trigger1 = stateno = 5001 || stateno = 5011 || stateno = 151 || stateno = 153
trigger1 = gethitvar(fall.envshake.time) = 4 && Time >= 1 && Time <= 12
x = -0.89 * (ifelse(Time = 1, 4, ifelse(Time = 2, 7, ifelse(Time = 3, 9, ifelse(Time = 4, 10, ifelse(Time = 5, 12, ifelse(Time = 6, 9, ifelse(Time = 7, 6, ifelse(Time = 8, 5, ifelse(Time = 9, 4, ifelse(Time = 10, 3, ifelse(Time = 11, 2, ifelse(Time = 12, 1, 0)))))))))))))

[State -2, Three-Point step]
type = VelSet
trigger1 = stateno = 250 && prevstateno = 240
trigger1 = Time < 10
x = 3.4

[State -2, Master's Combination step]
type = VelSet
trigger1 = stateno = 220 && prevstateno = 210
trigger1 = Time < 7
x = ifelse(P2BodyDist X > 28, 5, ifelse(P2BodyDist X > 10, 2.5, 0))

;---------------------------------------------------------------------------
; 3rd Strike super gauge (see SA_ARTS in cnsgen.py)
[State -2, SA default]
type = MapSet
trigger1 = Map(sa) = 0
map = "sa"
value = ifelse(AILevel > 0, 1 + Random % 3, 1)
ignorehitpause = 1

[State -2, SA bar length]
type = MapSet
trigger1 = 1
map = "sagl"
value = ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112))
ignorehitpause = 1

[State -2, SA stocks]
type = ModifyPlayer
trigger1 = PowerMax != ifelse(Map(sa) = 2, 1, ifelse(Map(sa) = 3, 3, 2)) * 1000
powermax = ifelse(Map(sa) = 2, 1, ifelse(Map(sa) = 3, 3, 2)) * 1000
ignorehitpause = 1

[State -2, Gauge counted reset]
type = VarSet
trigger1 = HitCount < var(36)
trigger2 = Time = 0
var(36) = 0
ignorehitpause = 1

[State -2, Guard counted reset]
type = VarSet
trigger1 = Time = 0 || !MoveContact
var(37) = 0
ignorehitpause = 1

[State -2, Parry gain]
type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = (stateno = [700, 702]) && Time = 1
value = floor((4) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)

[State -2, Throw gain]
type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = (stateno = 810 || stateno = 815) && Time = 1
value = floor((7) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)

[State -2, Throw gain (defender)]
type = TargetPowerAdd
trigger1 = (stateno = 810 || stateno = 815) && Time = 1 && numtarget
value = floor(7 / 3 * 1.2 * 1000 / ifelse((target, Map(sagl)) > 0, (target, Map(sagl)), 112) + .5)

[State -2, Gain start class 1]
type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = Time = 1 && (stateno = 200 || stateno = 230 || stateno = 400 || stateno = 430 || stateno = 600 || stateno = 630 || stateno = 1205 || stateno = 1255)
value = floor((0) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)

[State -2, Gain hit class 1]
type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = HitCount > var(36) && (stateno = 200 || stateno = 230 || stateno = 400 || stateno = 430 || stateno = 600 || stateno = 630 || stateno = 1205 || stateno = 1255)
value = floor((ifelse(HitCount = 1, 2, 2) * ifelse(ComboCount <= 1, 32, ifelse(ComboCount >= 16, 1, 32 - (ComboCount - 1) * 2)) / 32.0) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
ignorehitpause = 1

[State -2, Gain hit class 1 (defender)]
type = TargetPowerAdd
trigger1 = HitCount > var(36) && numtarget && (stateno = 200 || stateno = 230 || stateno = 400 || stateno = 430 || stateno = 600 || stateno = 630 || stateno = 1205 || stateno = 1255)
value = floor(ifelse(HitCount = 1, 2, 2) / 3 * 1.2 * 1000 / ifelse((target, Map(sagl)) > 0, (target, Map(sagl)), 112) + .5)
ignorehitpause = 1

[State -2, Gain guard class 1]
type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = MoveGuarded && var(37) = 0 && (stateno = 200 || stateno = 230 || stateno = 400 || stateno = 430 || stateno = 600 || stateno = 630 || stateno = 1205 || stateno = 1255)
value = floor((1) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
ignorehitpause = 1

[State -2, Gain start class 4]
type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = Time = 1 && (stateno = 210 || stateno = 240 || stateno = 260 || stateno = 300 || stateno = 320 || stateno = 410 || stateno = 440 || stateno = 610 || stateno = 640)
value = floor((2) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)

[State -2, Gain hit class 4]
type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = HitCount > var(36) && (stateno = 210 || stateno = 240 || stateno = 260 || stateno = 300 || stateno = 320 || stateno = 410 || stateno = 440 || stateno = 610 || stateno = 640)
value = floor((ifelse(HitCount = 1, 8, 2) * ifelse(ComboCount <= 1, 32, ifelse(ComboCount >= 16, 1, 32 - (ComboCount - 1) * 2)) / 32.0) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
ignorehitpause = 1

[State -2, Gain hit class 4 (defender)]
type = TargetPowerAdd
trigger1 = HitCount > var(36) && numtarget && (stateno = 210 || stateno = 240 || stateno = 260 || stateno = 300 || stateno = 320 || stateno = 410 || stateno = 440 || stateno = 610 || stateno = 640)
value = floor(ifelse(HitCount = 1, 8, 2) / 3 * 1.2 * 1000 / ifelse((target, Map(sagl)) > 0, (target, Map(sagl)), 112) + .5)
ignorehitpause = 1

[State -2, Gain guard class 4]
type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = MoveGuarded && var(37) = 0 && (stateno = 210 || stateno = 240 || stateno = 260 || stateno = 300 || stateno = 320 || stateno = 410 || stateno = 440 || stateno = 610 || stateno = 640)
value = floor((4) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
ignorehitpause = 1

[State -2, Gain start class 7]
type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = Time = 1 && (stateno = 220 || stateno = 250 || stateno = 310 || stateno = 330 || stateno = 340 || stateno = 420 || stateno = 450 || stateno = 620 || stateno = 650)
value = floor((3) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)

[State -2, Gain hit class 7]
type = PowerAdd
triggerall = Map(harmony) <= 0
trigger1 = HitCount > var(36) && (stateno = 220 || stateno = 250 || stateno = 310 || stateno = 330 || stateno = 340 || stateno = 420 || stateno = 450 || stateno = 620 || stateno = 650)
value = floor((ifelse(HitCount = 1, 14, 2) * ifelse(ComboCount <= 1, 32, ifelse(ComboCount >= 16, 1, 32 - (ComboCount - 1) * 2)) / 32.0) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
