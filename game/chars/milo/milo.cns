;===========================================================================
; Parry (3rd Strike rules, from the arcade program: cmd_data.c pc_cmd_03-06/12,
; cmd_main_2.c check_10, HITCHECK.c set_paring_status):
;  - tap forward (high/mid) or down (low/mid) from a NEUTRAL lever; air parry = tap forward in the air
;  - window: 11 frames on the ground, 8 in the air, 6 against jump-ins; holding the
;    lever cuts it to 6; a new press after releasing closes it; back always closes it
;  - lockout: 21 frames after a tap (18 in the air); a success clears it so multi-hits can be parried
;  - while blocking (guard stun) the window is only 3 frames (the "red parry")
;  - freeze: the parrier stops for 15 frames, the attacker for 16 (specials, jump-ins)
;    or 16 + 4/3/2 (light/medium/heavy normals), so the parrier always acts first
;---------------------------------------------------------------------------
; High parry success
[Statedef 700]
type = S
movetype = I
physics = S
anim = 700
ctrl = 0
sprpriority = 2
velset = 0,0

[State 700, Re-arm]
type = VarSet
trigger1 = Time = 0
var(20) = 0
ignorehitpause = 1

[State 700, Window off]
type = VarSet
trigger1 = Time = 0
var(21) = 0
ignorehitpause = 1

[State 700, Freeze vs normals]
type = Pause
trigger1 = Time = 0 && enemynear, statetype != A && enemynear, HitDefAttr = SC, NA
time = 19
movetime = 19
persistent = 0
ignorehitpause = 1

[State 700, Freeze vs others]
type = Pause
trigger1 = Time = 0 && !(enemynear, statetype != A && enemynear, HitDefAttr = SC, NA)
time = 16
movetime = 16
persistent = 0
ignorehitpause = 1

[State 700, Parrier freeze]
type = PosFreeze
trigger1 = Time < 15
value = 1

[State 700, Flash]
type = PalFX
trigger1 = Time = 0
time = 15
add = 40, 90, 200
persistent = 0
ignorehitpause = 1

[State 700, Spark]
type = Explod
trigger1 = Time = 0
anim = 6200
postype = p1
pos = 22, -58
scale = .5, .5
sprpriority = 5
ownpal = 1
removetime = -2
pausemovetime = 19
persistent = 0
ignorehitpause = 1

[State 700, Meter]
type = PowerAdd
trigger1 = Time = 0
value = 30
persistent = 0

[State 700, Control]
type = CtrlSet
trigger1 = Time >= 15
value = 1

[State 700, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

