triggerall = Map(harmony) <= 0
trigger1 = MoveGuarded && var(37) = 0 && (stateno = 1200 || stateno = 1201 || stateno = 1202 || stateno = 1252 || stateno = 1300 || stateno = 1301 || stateno = 1302 || stateno = 1400 || stateno = 1401 || stateno = 1402)
value = floor((8) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
ignorehitpause = 1

[State -2, Hits counted]
type = VarSet
trigger1 = HitCount > var(36)
var(36) = HitCount
ignorehitpause = 1

[State -2, Guard counted]
type = VarSet
trigger1 = MoveGuarded && var(37) = 0
var(37) = 1
ignorehitpause = 1

;---------------------------------------------------------------------------
; SA III Perfect Harmony install
[State -2, Harmony reset]
type = MapSet
trigger1 = RoundState < 2 && Map(harmony) != 0
map = "harmony"
value = 0

[State -2, Harmony countdown]
type = MapAdd
trigger1 = RoundState = 2 && Map(harmony) > 0
map = "harmony"
value = -1

[State -2, Harmony aura]
type = PalFX
trigger1 = Map(harmony) > 0 && !(stateno = [3000, 3200])
time = 2
add = 10, 40, 80
sinadd = 20, 30, 50, 30

[State -2, Harmony sparks]
type = Explod
trigger1 = Map(harmony) > 0 && (Map(harmony) % 24) = 0
anim = 6030
postype = p1
pos = 0, 0
scale = .22, .22
sprpriority = 5
ownpal = 1
bindtime = -1
removetime = 14
ignorehitpause = 1

[State -2, Harmony ends]
type = PalFX
trigger1 = Map(harmony) = 1
time = 12
add = 160, 200, 255
sinadd = -160, -200, -255, 12

[State -2, Harmony quick recovery]
type = ChangeState
triggerall = Map(harmony) > 0 && movetype = A && statetype != A
triggerall = stateno >= 200 && stateno < 1600 && stateno != 1500 && stateno != 1501 && stateno != 1502 && stateno != 1503
trigger1 = AnimTime >= -6 && AnimTime < 0 && MoveContact
trigger2 = AnimTime >= -6 && AnimTime < 0 && stateno < 700
value = ifelse(statetype = C, 11, 0)
ctrl = 1

;---------------------------------------------------------------------------
; Sound effects
[State -2, Whoosh 0]
type = PlaySnd
trigger1 = movetype = A && ((stateno = 200 && Time = 1) || (stateno = 230 && Time = 2) || (stateno = 400 && Time = 1) || (stateno = 430 && Time = 2) || (stateno = 600 && Time = 2) || (stateno = 630 && Time = 2))
value = S0, 0

[State -2, Whoosh 1]
type = PlaySnd
trigger1 = movetype = A && ((stateno = 210 && Time = 3) || (stateno = 240 && Time = 5) || (stateno = 410 && Time = 3) || (stateno = 440 && Time = 4) || (stateno = 610 && Time = 3) || (stateno = 640 && Time = 4) || (stateno = 260 && Time = 16) || (stateno = 300 && Time = 5) || (stateno = 320 && Time = 9))
value = S0, 1

[State -2, Whoosh 2]
type = PlaySnd
trigger1 = movetype = A && ((stateno = 220 && Time = 6) || (stateno = 250 && Time = 9) || (stateno = 420 && Time = 4) || (stateno = 450 && Time = 6) || (stateno = 620 && Time = 5) || (stateno = 650 && Time = 6) || (stateno = 310 && Time = 14) || (stateno = 330 && Time = 9) || (stateno = 340 && Time = 8))
value = S0, 2

[State -2, Voice effort 0]
type = PlaySnd
trigger1 = Time = 1 && movetype = A && Random < 300 && (stateno = 200 || stateno = 230 || stateno = 400 || stateno = 430 || stateno = 600 || stateno = 630)
value = S10, Random % 3
channel = 0

[State -2, Voice effort 1]
type = PlaySnd
trigger1 = Time = 1 && movetype = A && Random < 600 && (stateno = 210 || stateno = 240 || stateno = 410 || stateno = 440 || stateno = 610 || stateno = 640 || stateno = 260 || stateno = 300 || stateno = 320)
value = S11, Random % 3
channel = 0

[State -2, Voice effort 2]
type = PlaySnd
trigger1 = Time = 1 && movetype = A && Random < 900 && (stateno = 220 || stateno = 250 || stateno = 420 || stateno = 450 || stateno = 620 || stateno = 650 || stateno = 310 || stateno = 330 || stateno = 340)
value = S12, Random % 5
channel = 0

[State -2, Voice Thunderline]
type = PlaySnd
trigger1 = Time = 1 && stateno = [1000, 1003]
value = S20, 0
channel = 0

[State -2, Voice Volt Ascension]
type = PlaySnd
trigger1 = Time = 1 && stateno = [1100, 1103]
value = S20, 1
channel = 0

[State -2, Voice Flashstep]
type = PlaySnd
trigger1 = Time = 1 && stateno = [1200, 1203]
value = S20, 2
channel = 0

[State -2, Voice other specials]
type = PlaySnd
trigger1 = Time = 1 && (stateno = [1300, 1303] || stateno = [1400, 1403])
value = S12, Random % 5
channel = 0

[State -2, Voice counter caught]
type = PlaySnd
trigger1 = Time = 1 && stateno = 1510
value = S16, 0
channel = 0

[State -2, Voice throw]
type = PlaySnd
trigger1 = Time = 1 && (stateno = 810 || stateno = 815)
value = S13, 0
channel = 0

[State -2, Voice SA I]
type = PlaySnd
trigger1 = Time = 1 && stateno = 3000
value = S21, 0
channel = 0
ignorehitpause = 1

[State -2, Voice SA II]
type = PlaySnd
trigger1 = Time = 1 && stateno = 3100
value = S21, 1
channel = 0
ignorehitpause = 1

[State -2, Voice SA III]
type = PlaySnd
trigger1 = Time = 1 && stateno = 3200
value = S21, 2
channel = 0
ignorehitpause = 1

[State -2, Voice hurt]
type = PlaySnd
trigger1 = Alive && Time = 0 && Random < 650 && (stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070)
value = S14, Random % 5
channel = 0
ignorehitpause = 1

[State -2, Voice KO]
type = PlaySnd
trigger1 = !Alive && Map(kocry) = 0
value = S15, 0
channel = 0
ignorehitpause = 1

[State -2, Voice KO once]
type = MapSet
trigger1 = !Alive && Map(kocry) = 0
map = "kocry"
value = 1
ignorehitpause = 1

[State -2, Voice KO reset]
type = MapSet
trigger1 = Alive && Map(kocry) != 0
map = "kocry"
value = 0

[State -2, Voice intro]
type = PlaySnd
trigger1 = stateno = 191 && Time = 20
value = S30, Random % 4
channel = 0

[State -2, Voice win]
type = PlaySnd
trigger1 = (stateno = 180 || stateno = 181) && Time = 25
value = S31, Random % 3
channel = 0

[State -2, Voice taunt]
type = PlaySnd
trigger1 = stateno = 195 && Time = 4
value = S32, 0
channel = 0

[State -2, Special whoosh]
type = PlaySnd
trigger1 = Time = 2 && movetype = A && (stateno = [1000, 1403] || stateno = 1510)
value = S0, 2

[State -2, Lightning on contact]
type = PlaySnd
trigger1 = MoveContact = 1 && (stateno = [1000, 1599] || stateno = 3100 || stateno = 3101)
value = S1, 0
channel = 2
ignorehitpause = 1

[State -2, Super finish armed]
type = MapSet
trigger1 = RoundState = 2 && (stateno = 3000 || stateno = 3100 || stateno = 3101 || (stateno = [3300, 3303]) || NumProjID(3000) > 0)
map = "sfin"
value = 20

[State -2, Super finish window]
type = MapAdd
trigger1 = RoundState = 2 && Map(sfin) > 0 && !(stateno = 3000 || stateno = 3100 || stateno = 3101 || (stateno = [3300, 3303]) || NumProjID(3000) > 0)
map = "sfin"
value = -1

[State -2, Super finish caught]
type = MapSet
trigger1 = RoundState = 3 && Map(sfin) > 0 && Map(sfin) < 1000 && Win
map = "sfin"
value = 1075

[State -2, Super finish count]
type = MapAdd
trigger1 = Map(sfin) > 1000
map = "sfin"
value = -1
ignorehitpause = 1

[State -2, Super finish call]
type = PlaySnd
trigger1 = Map(sfin) = 1001
value = F3, 0
ignorehitpause = 1

[State -2, Super finish reset]
type = MapSet
trigger1 = RoundState < 2 && Map(sfin) != 0
map = "sfin"
value = 0

[State -2, Parry sound]
type = PlaySnd
trigger1 = (stateno = [700, 702]) && Time = 1
value = S2, 0
ignorehitpause = 1

[State -2, Dash sound]
type = PlaySnd
trigger1 = Time = 1 && (stateno = 100 || stateno = 105 || stateno = [1200, 1203])
value = S4, 0

[State -2, Armor break flag]
type = MapSet
trigger1 = 1
map = "armorbreak"
value = (stateno = 1302 && movetype = A)
ignorehitpause = 1

[State -2, Mirror match colour]
type = RemapPal
trigger1 = RoundState <= 1 && TeamSide = 2 && PalNo <= 3
trigger1 = enemynear, name = name
source = 1,1
dest = 1, PalNo + 3

[State -2, Parry lockout countdown]
type = VarAdd
trigger1 = var(20) > 0
var(20) = -1

[State -2, Parry window countdown]
type = VarAdd
trigger1 = var(21) > 0
var(21) = -1

[State -2, Parry age]
type = VarAdd
trigger1 = var(21) > 0
var(23) = 1

; 3rd Strike (cmd_main_2.c check_10): a tap that is held for 6 frames closes its window;
; once the lever is released, the window stays open for the full time unless a new
; direction is pressed (and back always closes it).
[State -2, Parry released]
type = VarSet
trigger1 = var(21) > 0 && command != "holdfwd" && command != "holdback" && command != "holdup" && command != "holddown"
var(25) = 1

[State -2, Parry held too long]
type = VarSet
trigger1 = var(21) > 0 && var(25) = 0 && var(23) >= 7
var(21) = 0

[State -2, Parry new press closes]
type = VarSet
trigger1 = var(21) > 0 && var(25) = 1
trigger1 = command = "holdfwd" || command = "holdback" || command = "holdup" || command = "holddown"
trigger2 = var(21) > 0 && command = "holdback"
var(21) = 0

[State -2, Parry cancelled by attacking]
type = VarSet
trigger1 = var(21) > 0 && movetype = A
var(21) = 0
ignorehitpause = 1

[State -2, High parry armed]
type = HitOverride
trigger1 = var(21) > 0 && var(22) = 1 && movetype != A && statetype != A
attr = SC, AA, AP
guardflag = H
stateno = 700
slot = 0
time = 1
ignorehitpause = 1

; Jump-ins are parried from the ground with a shorter, 6-frame window (3rd Strike slot 12)
[State -2, High parry vs jump-ins]
type = HitOverride
trigger1 = var(21) > 0 && var(23) <= 6 && var(22) = 1 && movetype != A && statetype != A
attr = A, AA, AP
stateno = 700
slot = 3
time = 1
ignorehitpause = 1

[State -2, Low parry armed]
type = HitOverride
trigger1 = var(21) > 0 && var(22) = 2 && movetype != A && statetype != A
attr = SC, AA, AP
guardflag = L
stateno = 701
slot = 0
time = 1
ignorehitpause = 1

[State -2, Air parry armed]
type = HitOverride
trigger1 = var(21) > 0 && var(22) = 3 && movetype != A && statetype = A
attr = SCA, AA, AP
stateno = 702
slot = 0
time = 1
ignorehitpause = 1

;===========================================================================
; Presentation
;===========================================================================
; CPU (3rd Strike arcade CPU, see cpugen.py). Runs only when the engine says this player is CPU.
[State -2, CPU no random buttons]
type = AssertSpecial
triggerall = AILevel > 0
trigger1 = 1
flag = noaibuttonjam
flag2 = noaicheat
ignorehitpause = 1

[State -2, CPU rank load]
type = LoadFile
triggerall = AILevel > 0
trigger1 = GameMode = "arcade" && RoundNo = 1 && RoundState = 0 && Time = 0 && MatchNo > 1
path = "cpurank.sav"
savedata = map
maps = "cpurank"
ignorehitpause = 1

[State -2, CPU rank from file]
type = VarSet
triggerall = AILevel > 0
trigger1 = GameMode = "arcade" && RoundNo = 1 && RoundState = 0 && Time = 0 && MatchNo > 1 && map(cpurank) > 0
var(45) = map(cpurank)
ignorehitpause = 1

[State -2, CPU rank new run]
type = VarSet
triggerall = AILevel > 0
trigger1 = GameMode = "arcade" && RoundNo = 1 && RoundState = 0 && Time = 0 && MatchNo = 1
var(45) = 481
ignorehitpause = 1

[State -2, CPU rank start]
type = VarSet
triggerall = AILevel > 0
trigger1 = var(45) = 0
var(45) = 481
ignorehitpause = 1

[State -2, CPU round reset]
type = VarSet
triggerall = AILevel > 0
trigger1 = RoundState <= 1
var(56) = 0
ignorehitpause = 1

[State -2, CPU round reset mode]
type = VarSet
triggerall = AILevel > 0
trigger1 = RoundState <= 1
var(40) = 0
ignorehitpause = 1

[State -2, CPU rank after round]
type = VarAdd
triggerall = AILevel > 0
trigger1 = RoundState = 4 && var(56) = 0 && enemynear, AILevel = 0
var(45) = ifelse(Life < enemynear, Life, 40, -40)
ignorehitpause = 1

[State -2, CPU rank clamp]
type = VarSet
triggerall = AILevel > 0
trigger1 = RoundState = 4 && var(56) = 0
var(45) = ifelse(var(45) > 1061, 1061, ifelse(var(45) < 0, 0, var(45)))
ignorehitpause = 1

[State -2, CPU rank map]
type = MapSet
triggerall = AILevel > 0
trigger1 = RoundState = 4 && var(56) = 0 && GameMode = "arcade"
map = "cpurank"
value = var(45)
ignorehitpause = 1

[State -2, CPU rank save]
type = SaveFile
triggerall = AILevel > 0
trigger1 = RoundState = 4 && var(56) = 0 && GameMode = "arcade"
path = "cpurank.sav"
savedata = map
maps = "cpurank"
ignorehitpause = 1

[State -2, CPU rank done]
type = VarSet
triggerall = AILevel > 0
trigger1 = RoundState = 4
var(56) = 1
ignorehitpause = 1

[State -2, CPU lever reset]
type = VarSet
triggerall = AILevel > 0
trigger1 = 1
var(44) = var(49)

[State -2, CPU random]
type = VarSet
triggerall = AILevel > 0
trigger1 = 1
var(52) = Random

[State -2, CPU hit]
type = VarSet
triggerall = AILevel > 0
trigger1 = movetype = H
var(40) = 0

[State -2, CPU hit lever]
type = VarSet
triggerall = AILevel > 0
trigger1 = movetype = H
var(49) = 0

[State -2, CPU throw escape roll]
type = VarSet
triggerall = AILevel > 0
trigger1 = stateno = 820 && Time = 1
