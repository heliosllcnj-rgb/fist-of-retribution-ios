trigger1 = HitCount > var(36) && (stateno = 1200 || stateno = 1201 || stateno = 1202 || stateno = 1252 || stateno = 1300 || stateno = 1301 || stateno = 1302 || stateno = 1400 || stateno = 1401 || stateno = 1402)
value = floor((ifelse(HitCount = 1, 13, 2) * ifelse(ComboCount <= 1, 32, ifelse(ComboCount >= 16, 1, 32 - (ComboCount - 1) * 2)) / 32.0) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
ignorehitpause = 1

[State -2, Gain hit class 12 (defender)]
type = TargetPowerAdd
trigger1 = HitCount > var(36) && numtarget && (stateno = 1200 || stateno = 1201 || stateno = 1202 || stateno = 1252 || stateno = 1300 || stateno = 1301 || stateno = 1302 || stateno = 1400 || stateno = 1401 || stateno = 1402)
value = floor(ifelse(HitCount = 1, 13, 2) / 3 * 1.2 * 1000 / ifelse((target, Map(sagl)) > 0, (target, Map(sagl)), 112) + .5)
ignorehitpause = 1

[State -2, Gain guard class 12]
