;===========================================================================
; Forward dash (Ken's DASH HUMIKOMI script + ken_movexy_table row 2, scaled by K3S):
; 1 frame of stance, then 16 px step, 8 px/f slowing by 8/256 for 8 frames, a second 16 px step,
; and 14 more frames on the spot: 23 frames, 95 px. The two steps are spread over the moving frames
; so the sprite glides instead of popping.
[Statedef 100]
type = S
movetype = I
physics = N
anim = 100
ctrl = 0
velset = 0,0
sprpriority = 1

[State 100, Move]
type = VelSet
trigger1 = Time >= 1 && Time <= 9
x = 0.89 * (32.0 / 9 + ifelse(Time <= 8, 8 - 0.03125 * (Time - 1), 0))

[State 100, Stop]
type = VelSet
trigger1 = Time >= 10
x = 0

[State 100, End]
type = ChangeState
trigger1 = Time >= 23
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Back dash (DASH TOBINOKI + row 3): 8 px and 24 px steps, then 10 px/f slowing by 3 px/f to a stop:
; 54 px in 21 frames, on the ground and throwable, as in 3rd Strike.
[Statedef 105]
type = S
movetype = I
physics = N
anim = 105
ctrl = 0
velset = 0,0
sprpriority = 1

[State 105, Move]
type = VelSet
trigger1 = Time >= 2 && Time <= 7
x = -0.89 * ifelse(Time <= 3, 4, ifelse(Time = 4, 22, ifelse(Time = 5, 19, ifelse(Time = 6, 4, 1))))

[State 105, Stop]
type = VelSet
trigger1 = Time >= 8
x = 0

[State 105, End]
type = ChangeState
trigger1 = Time >= 21
value = 0
ctrl = 1

;===========================================================================
; Jump start. Each jump has its own launch speed, gravity and (for some) x drag, taken from the
; arcade program's movement records (see chardata.JUMPS); var(26) remembers which jump is in the air
; so the -2 state can keep applying its gravity and drag through air attacks.
; Pre-jump: 3 frames (JUMP JUNBI). Super jump: down, then up; 5 frames (SP JUMP JUNBI).
[Statedef 40]
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1
velset = 0,0

[State 40, Kind]
type = VarSet
trigger1 = Time = 0
var(26) = 1

[State 40, Super]
type = VarSet
trigger1 = Time = 0
var(27) = command = "superjump"

[State 40, Fwd]
type = VarSet
trigger1 = command = "holdfwd"
var(26) = 2

[State 40, Back]
type = VarSet
trigger1 = command = "holdback"
var(26) = 3

[State 40, Launch kind]
type = VarAdd
trigger1 = (var(27) = 0 && Time >= 2) || (var(27) = 1 && Time >= 4)
var(26) = 3 * var(27)

[State 40, Launch]
type = VelSet
trigger1 = (var(27) = 0 && Time >= 2) || (var(27) = 1 && Time >= 4)
