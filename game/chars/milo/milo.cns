trigger1 = HitCount > var(36) && numtarget && (stateno = 1100 || stateno = 1101 || stateno = 1102 || stateno = 1510)
value = floor(ifelse(HitCount = 1, 15, 2) / 3 * 1.2 * 1000 / ifelse((target, Map(sagl)) > 0, (target, Map(sagl)), 112) + .5)
