[Quotes]
victory1 = "Feel the rhythm yet?"
victory2 = "WKC champ for a reason, baby!"
victory3 = "Respect. Now go run it back."
victory4 = "Ain't nothin' personal. Just rhythm."

;---------------------------------------------------------------------------
; Variable usage
; var(5)  - Absolute Flow install timer (Andre only, ticks remaining)
; var(20) - Parry lockout timer (no new parry input while > 0)
; var(21) - Parry window timer (parry is armed while > 0)
; var(22) - Parry type: 1 = high (tap forward), 2 = low (tap down), 3 = air (tap forward in air)
; var(23) - Frames since the parry tap (the window shortens to 6 if the lever is held)
; var(24) - Lever was neutral last frame (a parry tap must start from neutral, as in 3rd Strike)
; var(25) - Lever has been released since the parry tap (a new press then closes the window)
; var(50) - Super Art picked on the select screen (1-3; the select screen's palette menu)
;---------------------------------------------------------------------------

;===========================================================================
; Every-frame system logic: parry windows (3rd Strike-style)
[Statedef -2]

[State -2, Super Art from select screen]
type = VarSet
trigger1 = RoundState <= 1 || var(50) = 0
var(50) = ifelse(PalNo >= 1 && PalNo <= 6, (PalNo - 1) % 3 + 1, 1)
ignorehitpause = 1

[State -2, Jump arc N]
type = VelAdd
trigger1 = statetype = A && movetype != H && var(26) = 1
x = 0.0
y = -0.0002

[State -2, Jump arc F]
type = VelAdd
trigger1 = statetype = A && movetype != H && var(26) = 2
x = 0.0
y = -0.0002

[State -2, Jump arc B]
type = VelAdd
trigger1 = statetype = A && movetype != H && var(26) = 3
x = 0.0
y = -0.0002

[State -2, Jump arc SN]
type = VelAdd
trigger1 = statetype = A && movetype != H && var(26) = 4
x = 0.0
y = 0.0137

[State -2, Jump arc SF]
type = VelAdd
trigger1 = statetype = A && movetype != H && var(26) = 5
x = 0.0
y = 0.0137

[State -2, Jump arc SB]
type = VelAdd
trigger1 = statetype = A && movetype != H && var(26) = 6
x = 0.0
y = 0.0137

[State -2, Jump landing stops]
type = VelSet
trigger1 = stateno = 52 || (stateno = 50 && pos y >= 0 && vel y > 0)
x = 0

[State -2, Jump arc over]
type = VarSet
trigger1 = var(26) != 0 && stateno != 40
trigger1 = statetype != A || movetype = H
var(26) = 0

[State -2, Push-back row 1]
type = PosAdd
trigger1 = stateno = 5001 || stateno = 5011 || stateno = 151 || stateno = 153
trigger1 = gethitvar(fall.envshake.time) = 1 && Time >= 1 && Time <= 7
x = -0.89 * (ifelse(Time = 1, 3, ifelse(Time = 2, 5, ifelse(Time = 3, 6, ifelse(Time = 4, 7, ifelse(Time = 5, 6, ifelse(Time = 6, 4, ifelse(Time = 7, 1, 0))))))))

[State -2, Push-back row 3]
type = PosAdd
trigger1 = stateno = 5001 || stateno = 5011 || stateno = 151 || stateno = 153
trigger1 = gethitvar(fall.envshake.time) = 3 && Time >= 1 && Time <= 9
x = -0.89 * (ifelse(Time = 1, 4, ifelse(Time = 2, 7, ifelse(Time = 3, 9, ifelse(Time = 4, 10, ifelse(Time = 5, 11, ifelse(Time = 6, 8, ifelse(Time = 7, 6, ifelse(Time = 8, 4, ifelse(Time = 9, 1, 0))))))))))

[State -2, Push-back row 4]
type = PosAdd
trigger1 = stateno = 5001 || stateno = 5011 || stateno = 151 || stateno = 153
trigger1 = gethitvar(fall.envshake.time) = 4 && Time >= 1 && Time <= 12
x = -0.89 * (ifelse(Time = 1, 4, ifelse(Time = 2, 7, ifelse(Time = 3, 9, ifelse(Time = 4, 10, ifelse(Time = 5, 12, ifelse(Time = 6, 9, ifelse(Time = 7, 6, ifelse(Time = 8, 5, ifelse(Time = 9, 4, ifelse(Time = 10, 3, ifelse(Time = 11, 2, ifelse(Time = 12, 1, 0)))))))))))))

;---------------------------------------------------------------------------
; Sound effects and voice (Andre)
[State -2, Whoosh 0]
type = PlaySnd
trigger1 = movetype = A && ((stateno = 200 && Time = 1) || (stateno = 230 && Time = 2) || (stateno = 400 && Time = 1) || (stateno = 430 && Time = 2) || (stateno = 600 && Time = 2) || (stateno = 630 && Time = 2))
value = S0, 0

[State -2, Whoosh 1]
type = PlaySnd
trigger1 = movetype = A && ((stateno = 210 && Time = 3) || (stateno = 240 && Time = 4) || (stateno = 410 && Time = 3) || (stateno = 440 && Time = 4) || (stateno = 610 && Time = 3) || (stateno = 640 && Time = 4) || (stateno = 260 && Time = 16))
value = S0, 1

[State -2, Whoosh 2]
type = PlaySnd
trigger1 = movetype = A && ((stateno = 220 && Time = 5) || (stateno = 250 && Time = 8) || (stateno = 420 && Time = 3) || (stateno = 450 && Time = 6) || (stateno = 620 && Time = 5) || (stateno = 650 && Time = 6))
value = S0, 2

[State -2, Voice effort 0]
type = PlaySnd
trigger1 = Time = 1 && movetype = A && Random < 300 && (stateno = 200 || stateno = 230 || stateno = 400 || stateno = 430 || stateno = 600 || stateno = 630)
value = S10, Random % 3
channel = 0

[State -2, Voice effort 1]
type = PlaySnd
trigger1 = Time = 1 && movetype = A && Random < 600 && (stateno = 210 || stateno = 240 || stateno = 410 || stateno = 440 || stateno = 610 || stateno = 640 || stateno = 260)
value = S11, Random % 3
channel = 0

[State -2, Voice effort 2]
type = PlaySnd
trigger1 = Time = 1 && movetype = A && Random < 900 && (stateno = 220 || stateno = 250 || stateno = 420 || stateno = 450 || stateno = 620 || stateno = 650)
value = S12, Random % 5
channel = 0

[State -2, Flick pulse]
type = PlaySnd
trigger1 = (stateno = 1000 && AnimElem = 5) || (stateno = 1003 && AnimElem = 4)
value = S1, 0
channel = 2

[State -2, Air blast]
type = PlaySnd
trigger1 = ((stateno = 1001 || stateno = 1002) && AnimElem = 6) || (stateno = 1003 && AnimElem = 7)
value = S1, 1
channel = 3

[State -2, Sonic Dominion strikes]
type = PlaySnd
trigger1 = stateno = 3100 && (AnimElem = 7 || AnimElem = 9 || AnimElem = 11 || AnimElem = 13 || AnimElem = 15 || AnimElem = 17)
value = S1, 0
channel = 2
ignorehitpause = 1

[State -2, Sonic Dominion big one]
type = PlaySnd
trigger1 = stateno = 3100 && AnimElem = 22
value = S1, 1
channel = 3
ignorehitpause = 1

[State -2, Kick cracks the air]
type = PlaySnd
trigger1 = MoveHit = 1 && (stateno = [1100, 1103]) && Time >= 10
value = S1, 2
channel = 2
ignorehitpause = 1

[State -2, Tempest last kick]
type = PlaySnd
trigger1 = MoveHit = 1 && (stateno = [1401, 1403]) && Time >= 39
value = S1, 2
channel = 2
ignorehitpause = 1

[State -2, Sound barrier]
type = PlaySnd
trigger1 = MoveHit = 1 && stateno = 3200 && Time >= 76
value = S1, 3
channel = 3
ignorehitpause = 1

[State -2, Special whoosh]
type = PlaySnd
trigger1 = Time = 2 && movetype = A && (stateno = [1100, 1103] || stateno = [1400, 1403] || stateno = 3200)
value = S0, 2

[State -2, Flow dodge]
type = PlaySnd
trigger1 = Time = 1 && (stateno = 1510 || stateno = 1520 || stateno = 1900 || stateno = [1200, 1203] || stateno = [1500, 1503])
value = S1, 4
channel = 2
ignorehitpause = 1

[State -2, Absolute Flow]
type = PlaySnd
trigger1 = Time = 1 && stateno = 3000
value = S1, 5
channel = 3
ignorehitpause = 1

[State -2, Super flash]
type = PlaySnd
trigger1 = Time = 0 && (stateno = 3000 || stateno = 3100 || stateno = 3200)
value = S3, 0
channel = 4
ignorehitpause = 1

[State -2, Parry sound]
type = PlaySnd
trigger1 = (stateno = [700, 702]) && Time = 1
value = S2, 0
ignorehitpause = 1

[State -2, Dash sound]
type = PlaySnd
trigger1 = Time = 1 && (stateno = 100 || stateno = 105)
value = S4, 0

[State -2, Voice Flowing Current]
type = PlaySnd
trigger1 = Time = 1 && stateno = [1000, 1003]
value = S20, 0
channel = 0

[State -2, Voice Rising Rhythm]
type = PlaySnd
trigger1 = Time = 1 && stateno = [1100, 1103]
value = S20, 1
channel = 0

[State -2, Voice Dancing Tempest]
type = PlaySnd
trigger1 = Time = 1 && stateno = [1400, 1403]
value = S20, 2
channel = 0

[State -2, Voice Flow State]
type = PlaySnd
trigger1 = Time = 1 && stateno = [1500, 1503]
value = S20, 3
channel = 0

[State -2, Voice counter caught]
type = PlaySnd
trigger1 = Time = 1 && stateno = 1310
value = S16, 0
channel = 0

[State -2, Voice throw]
type = PlaySnd
trigger1 = Time = 1 && stateno = 810
value = S13, 0
channel = 0

[State -2, Voice SA I]
type = PlaySnd
trigger1 = Time = 1 && stateno = 3100
value = S21, 0
channel = 0
ignorehitpause = 1

[State -2, Voice SA II]
type = PlaySnd
trigger1 = Time = 1 && stateno = 3200
value = S21, 1
channel = 0
ignorehitpause = 1

[State -2, Voice SA III]
type = PlaySnd
trigger1 = Time = 1 && stateno = 3000
value = S21, 2
channel = 0
ignorehitpause = 1

[State -2, Voice hurt]
type = PlaySnd
trigger1 = Alive && Time = 0 && Random < 650 && (stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070)
value = S14, Random % 5
channel = 0
ignorehitpause = 1

[State -2, Voice KO]
type = PlaySnd
trigger1 = !Alive && Map(kocry) = 0
value = S15, 0
channel = 0
ignorehitpause = 1

[State -2, Voice KO once]
type = MapSet
trigger1 = !Alive && Map(kocry) = 0
map = "kocry"
value = 1
ignorehitpause = 1

[State -2, Voice KO reset]
type = MapSet
trigger1 = Alive && Map(kocry) != 0
map = "kocry"
value = 0

[State -2, Voice intro]
type = PlaySnd
trigger1 = stateno = 191 && Time = 20
value = S30, Random % 3
channel = 0

[State -2, Voice win]
type = PlaySnd
trigger1 = (stateno = 180 || stateno = 181) && Time = 25
value = S31, Random % 4
channel = 0

[State -2, Voice taunt]
type = PlaySnd
trigger1 = stateno = 195 && Time = 4
value = S32, 0
channel = 0

[State -2, Super finish armed]
type = MapSet
trigger1 = RoundState = 2 && (stateno = 3100 || stateno = 3200 || NumProjID(3100) > 0)
map = "sfin"
value = 20

[State -2, Super finish window]
type = MapAdd
trigger1 = RoundState = 2 && Map(sfin) > 0 && !(stateno = 3100 || stateno = 3200 || NumProjID(3100) > 0)
map = "sfin"
value = -1

[State -2, Super finish caught]
type = MapSet
trigger1 = RoundState = 3 && Map(sfin) > 0 && Map(sfin) < 1000 && Win
map = "sfin"
value = 1075

[State -2, Super finish count]
type = MapAdd
trigger1 = Map(sfin) > 1000
map = "sfin"
value = -1
ignorehitpause = 1

[State -2, Super finish call]
type = PlaySnd
trigger1 = Map(sfin) = 1001
value = F3, 0
ignorehitpause = 1

[State -2, Super finish reset]
type = MapSet
trigger1 = RoundState < 2 && Map(sfin) != 0
map = "sfin"
value = 0

[State -2, Armor break flag]
type = MapSet
trigger1 = 1
map = "armorbreak"
value = (stateno = 1302 && movetype = A)
ignorehitpause = 1

[State -2, Mirror match colour]
type = RemapPal
trigger1 = RoundState <= 1 && TeamSide = 2 && PalNo <= 3
trigger1 = enemynear, name = name
source = 1,1
dest = 1, PalNo + 3

[State -2, Parry lockout countdown]
type = VarAdd
trigger1 = var(20) > 0
var(20) = -1

[State -2, Parry window countdown]
type = VarAdd
trigger1 = var(21) > 0
var(21) = -1

[State -2, Parry age]
type = VarAdd
trigger1 = var(21) > 0
var(23) = 1

; 3rd Strike (cmd_main_2.c check_10): a tap that is held for 6 frames closes its window;
; once the lever is released, the window stays open for the full time unless a new
; direction is pressed (and back always closes it).
[State -2, Parry released]
type = VarSet
trigger1 = var(21) > 0 && command != "holdfwd" && command != "holdback" && command != "holdup" && command != "holddown"
var(25) = 1

[State -2, Parry held too long]
type = VarSet
trigger1 = var(21) > 0 && var(25) = 0 && var(23) >= 7
var(21) = 0

[State -2, Parry new press closes]
type = VarSet
trigger1 = var(21) > 0 && var(25) = 1
trigger1 = command = "holdfwd" || command = "holdback" || command = "holdup" || command = "holddown"
trigger2 = var(21) > 0 && command = "holdback"
var(21) = 0

[State -2, Parry cancelled by attacking]
type = VarSet
trigger1 = var(21) > 0 && movetype = A
var(21) = 0
ignorehitpause = 1

[State -2, High parry armed]
type = HitOverride
trigger1 = var(21) > 0 && var(22) = 1 && movetype != A && statetype != A
attr = SC, AA, AP
guardflag = H
stateno = 700
slot = 0
time = 1
ignorehitpause = 1

; Jump-ins are parried from the ground with a shorter, 6-frame window (3rd Strike slot 12)
[State -2, High parry vs jump-ins]
type = HitOverride
trigger1 = var(21) > 0 && var(23) <= 6 && var(22) = 1 && movetype != A && statetype != A
attr = A, AA, AP
stateno = 700
slot = 3
time = 1
ignorehitpause = 1

[State -2, Low parry armed]
type = HitOverride
trigger1 = var(21) > 0 && var(22) = 2 && movetype != A && statetype != A
attr = SC, AA, AP
guardflag = L
stateno = 701
slot = 0
time = 1
ignorehitpause = 1

[State -2, Air parry armed]
type = HitOverride
trigger1 = var(21) > 0 && var(22) = 3 && movetype != A && statetype = A
attr = SCA, AA, AP
stateno = 702
slot = 0
time = 1
ignorehitpause = 1

; ---- Absolute Flow (SA III) install ----
; Standing still (or turning) = attacks automatically whiff via the dodge state.
; Walking = attacks and projectiles pass through him and he keeps walking.
; Any committed action (attack, special, throw, parry, dash, jump) = normal hurtbox.
; Throws are deliberately NOT covered, so the opponent always has an answer.
[State -2, Flow timer]
type = VarAdd
trigger1 = var(5) > 0
var(5) = -1

[State -2, Flow auto-dodge (standing)]
type = HitOverride
trigger1 = var(5) > 0
trigger1 = stateno = 0 || stateno = 5 || stateno = 1900
attr = SCA, NA, SA, HA, NP, SP, HP
stateno = 1900
slot = 1
time = 1
ignorehitpause = 1

[State -2, Flow phase-through (walking)]
type = HitOverride
trigger1 = var(5) > 0
trigger1 = stateno = 20
attr = SCA, NA, SA, HA, NP, SP, HP
keepstate = 1
slot = 2
time = 1
ignorehitpause = 1

[State -2, Flow aura]
type = PalFX
trigger1 = var(5) > 0 && var(5) % 20 = 0
time = 20
add = 10, 25, 55
sinadd = 12, 20, 40, 20

;===========================================================================
; Presentation
;---------------------------------------------------------------------------
; Combo Trials bridge
[State -2, Continue call]
type = PlaySnd
trigger1 = StateNo = 5500 && Time = 1 && !IsHelper
value = F3, 1
ignorehitpause = 1

[State -2, Trial timer]
type = AssertSpecial
trigger1 = Map(trial) > 0
flag = timerfreeze
flag2 = noko

[State -2, Trial reset place]
type = PosSet
trigger1 = Map(trs) > 0 && !IsHelper
x = Map(trx)
y = 0

[State -2, Trial reset stop]
type = VelSet
trigger1 = Map(trs) > 0 && !IsHelper
x = 0
y = 0

[State -2, Trial reset life]
type = LifeSet
trigger1 = Map(trs) > 0 && !IsHelper
value = LifeMax

[State -2, Trial reset afterimages]
type = AfterImageTime
trigger1 = Map(trs) > 0 && !IsHelper
time = 0

[State -2, Trial reset install]
type = MapSet
trigger1 = Map(trs) > 0 && !IsHelper
map = "harmony"
value = 0

[State -2, Trial reset flag]
type = MapSet
trigger1 = Map(trs) > 0 && !IsHelper
map = "trs"
value = Map(trs) + 1
ignorehitpause = 1

[State -2, Trial reset done]
type = MapSet
trigger1 = Map(trs) > 2 && !IsHelper
map = "trs"
value = 0
ignorehitpause = 1

[State -2, Trial reset stand]
type = SelfState
trigger1 = Map(trs) = 2 && !IsHelper
value = 0
ctrl = 1
ignorehitpause = 1

[State -2, Trial input U]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 1) > 0
flag = U
ignorehitpause = 1

[State -2, Trial input D]
type = AssertInput
