flag = x
ignorehitpause = 1

[State -2, Trial input y]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 32) > 0
flag = y
ignorehitpause = 1

[State -2, Trial input z]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 64) > 0
flag = z
ignorehitpause = 1

[State -2, Trial input a]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 128) > 0
flag = a
ignorehitpause = 1

[State -2, Trial input b]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 256) > 0
flag = b
ignorehitpause = 1

[State -2, Trial input c]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 512) > 0
flag = c
ignorehitpause = 1


