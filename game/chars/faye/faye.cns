type = PowerAdd
trigger1 = MoveGuarded && var(37) = 0 && (stateno = 1100 || stateno = 1101 || stateno = 1102 || stateno = 1103 || stateno = 1600 || stateno = 1601 || stateno = 1602 || stateno = 1603)
value = floor((10) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
ignorehitpause = 1

[State -2, Gain start class 12]
type = PowerAdd
trigger1 = Time = 1 && (stateno = 1200 || stateno = 1201 || stateno = 1202 || stateno = 1203 || stateno = 1220 || stateno = 1221 || stateno = 1400 || stateno = 1401 || stateno = 1402 || stateno = 1403 || stateno = 1500 || stateno = 1501 || stateno = 1502 || stateno = 1503)
value = floor((3) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)

[State -2, Gain hit class 12]
type = PowerAdd
trigger1 = HitCount > var(36) && (stateno = 1200 || stateno = 1201 || stateno = 1202 || stateno = 1203 || stateno = 1220 || stateno = 1221 || stateno = 1400 || stateno = 1401 || stateno = 1402 || stateno = 1403 || stateno = 1500 || stateno = 1501 || stateno = 1502 || stateno = 1503)
value = floor((ifelse(HitCount = 1, 13, 2) * ifelse(ComboCount <= 1, 32, ifelse(ComboCount >= 16, 1, 32 - (ComboCount - 1) * 2)) / 32.0) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
