trigger1 = HitCount > var(36) && (stateno = 1100 || stateno = 1101 || stateno = 1102 || stateno = 1103 || stateno = 1600 || stateno = 1601 || stateno = 1602 || stateno = 1603)
value = floor((ifelse(HitCount = 1, 15, 2) * ifelse(ComboCount <= 1, 32, ifelse(ComboCount >= 16, 1, 32 - (ComboCount - 1) * 2)) / 32.0) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
