value = floor((2) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
ignorehitpause = 1

[State -2, Gain start class 11]
type = PowerAdd
trigger1 = Time = 1 && (stateno = 1100 || stateno = 1101 || stateno = 1102 || stateno = 1103 || stateno = 1600 || stateno = 1601 || stateno = 1602 || stateno = 1603)
value = floor((3) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)

