triggerall = AILevel > 0
trigger1 = var(40) != 0 && var(59) > 360
var(40) = 0

[State -2, CPU stun mode]
type = VarSet
triggerall = AILevel > 0
trigger1 = enemynear, dizzy && enemynear, stateno = 6565300 && ctrl && statetype != A && RoundState = 2
var(40) = 0

[State -2, CPU stun walk]
type = VarSet
triggerall = AILevel > 0
trigger1 = enemynear, dizzy && enemynear, stateno = 6565300 && ctrl && statetype != A && RoundState = 2 && (p2dist x / 0.89) > 52
var(44) = 4

[State -2, CPU stun hit]
type = VarSet
triggerall = AILevel > 0
trigger1 = enemynear, dizzy && enemynear, stateno = 6565300 && ctrl && statetype != A && RoundState = 2 && (p2dist x / 0.89) <= 52
var(44) = 64

[State -2, CPU in U]
type = AssertInput
triggerall = AILevel > 0
trigger1 = (var(44) & 1) > 0
flag = U
ignorehitpause = 1

[State -2, CPU in D]
type = AssertInput
triggerall = AILevel > 0
trigger1 = (var(44) & 2) > 0
flag = D
ignorehitpause = 1

[State -2, CPU in F]
type = AssertInput
triggerall = AILevel > 0
trigger1 = (var(44) & 4) > 0
flag = F
ignorehitpause = 1

[State -2, CPU in B]
type = AssertInput
triggerall = AILevel > 0
trigger1 = (var(44) & 8) > 0
flag = B
ignorehitpause = 1

[State -2, CPU in x]
type = AssertInput
triggerall = AILevel > 0
trigger1 = (var(44) & 16) > 0
flag = x
ignorehitpause = 1

[State -2, CPU in y]
type = AssertInput
triggerall = AILevel > 0
trigger1 = (var(44) & 32) > 0
flag = y
ignorehitpause = 1

[State -2, CPU in z]
type = AssertInput
triggerall = AILevel > 0
trigger1 = (var(44) & 64) > 0
flag = z
ignorehitpause = 1

[State -2, CPU in a]
type = AssertInput
triggerall = AILevel > 0
trigger1 = (var(44) & 128) > 0
flag = a
ignorehitpause = 1

[State -2, CPU in b]
type = AssertInput
triggerall = AILevel > 0
trigger1 = (var(44) & 256) > 0
flag = b
ignorehitpause = 1

[State -2, CPU in c]
type = AssertInput
triggerall = AILevel > 0
trigger1 = (var(44) & 512) > 0
flag = c
ignorehitpause = 1


;---------------------------------------------------------------------------
; Combo Trials bridge
[State -2, Continue call]
type = PlaySnd
trigger1 = StateNo = 5500 && Time = 1 && !IsHelper
value = F3, 1
ignorehitpause = 1

[State -2, Trial timer]
type = AssertSpecial
trigger1 = Map(trial) > 0
flag = timerfreeze
flag2 = noko

[State -2, Trial reset place]
type = PosSet
trigger1 = Map(trs) > 0 && !IsHelper
x = Map(trx)
y = 0

[State -2, Trial reset stop]
type = VelSet
trigger1 = Map(trs) > 0 && !IsHelper
x = 0
y = 0

[State -2, Trial reset life]
type = LifeSet
trigger1 = Map(trs) > 0 && !IsHelper
value = LifeMax

[State -2, Trial reset afterimages]
type = AfterImageTime
trigger1 = Map(trs) > 0 && !IsHelper
time = 0

[State -2, Trial reset install]
type = MapSet
trigger1 = Map(trs) > 0 && !IsHelper
map = "harmony"
value = 0

[State -2, Trial reset flag]
type = MapSet
trigger1 = Map(trs) > 0 && !IsHelper
map = "trs"
value = Map(trs) + 1
ignorehitpause = 1

[State -2, Trial reset done]
type = MapSet
trigger1 = Map(trs) > 2 && !IsHelper
map = "trs"
value = 0
ignorehitpause = 1

[State -2, Trial reset stand]
type = SelfState
trigger1 = Map(trs) = 2 && !IsHelper
value = 0
ctrl = 1
ignorehitpause = 1

[State -2, Trial input U]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 1) > 0
flag = U
ignorehitpause = 1

[State -2, Trial input D]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 2) > 0
flag = D
ignorehitpause = 1

[State -2, Trial input F]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 4) > 0
flag = F
ignorehitpause = 1

[State -2, Trial input B]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 8) > 0
flag = B
ignorehitpause = 1

[State -2, Trial input x]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 16) > 0
flag = x
ignorehitpause = 1

[State -2, Trial input y]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 32) > 0
flag = y
ignorehitpause = 1

[State -2, Trial input z]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 64) > 0
flag = z
ignorehitpause = 1

[State -2, Trial input a]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 128) > 0
flag = a
ignorehitpause = 1

[State -2, Trial input b]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 256) > 0
flag = b
ignorehitpause = 1

[State -2, Trial input c]
type = AssertInput
trigger1 = Map(tin) > 0 && (floor(Map(tin)) & 512) > 0
flag = c
ignorehitpause = 1


