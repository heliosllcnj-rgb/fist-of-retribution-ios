type = PowerAdd
trigger1 = MoveGuarded && var(37) = 0 && (stateno = 220 || stateno = 250 || stateno = 310 || stateno = 330 || stateno = 420 || stateno = 450 || stateno = 620 || stateno = 650)
value = floor((6) * 1.2 * 1000 / ifelse(Map(sa) = 2, 128, ifelse(Map(sa) = 3, 80, 112)) + .5)
